{
  "name": "claude-edits",
  "displayName": "Claude Edits",
  "description": "Reviews the files Claude Code sessions edited, as redpen's recorder keeps them: their changes side by side, with Keep and Undo.",
  "publisher": "local",
  "version": "0.5.1",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeEdits",
          "title": "Claude Edits",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claudeEdits": [
        {
          "id": "claudeEdits.files",
          "name": "Files"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeEdits.refresh",
        "title": "Refresh",
        "category": "Claude Edits",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeEdits.openFile",
        "title": "Open File",
        "category": "Claude Edits",
        "icon": "$(go-to-file)"
      },
      {
        "command": "claudeEdits.openDiff",
        "title": "Open Changes",
        "category": "Claude Edits",
        "icon": "$(diff)"
      },
      {
        "command": "claudeEdits.keepFile",
        "title": "Keep File",
        "category": "Claude Edits",
        "icon": "$(check)"
      },
      {
        "command": "claudeEdits.undoFile",
        "title": "Undo File",
        "category": "Claude Edits",
        "icon": "$(discard)"
      },
      {
        "command": "claudeEdits.keepSession",
        "title": "Keep All",
        "category": "Claude Edits",
        "icon": "$(check-all)"
      },
      {
        "command": "claudeEdits.dismiss",
        "title": "Dismiss Session",
        "category": "Claude Edits",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeEdits.refresh",
          "when": "view == claudeEdits.files",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeEdits.undoFile",
          "when": "view == claudeEdits.files && viewItem == file.changed",
          "group": "inline@1"
        },
        {
          "command": "claudeEdits.keepFile",
          "when": "view == claudeEdits.files && viewItem == file.changed",
          "group": "inline@2"
        },
        {
          "command": "claudeEdits.openFile",
          "when": "view == claudeEdits.files && viewItem =~ /^file/",
          "group": "inline@3"
        },
        {
          "command": "claudeEdits.keepSession",
          "when": "view == claudeEdits.files && viewItem == session",
          "group": "inline@1"
        },
        {
          "command": "claudeEdits.dismiss",
          "when": "view == claudeEdits.files && viewItem == session",
          "group": "inline@2"
        }
      ],
      "editor/title": [
        {
          "command": "claudeEdits.undoFile",
          "when": "resourcePath in claudeEdits.changedFiles",
          "group": "navigation@1"
        },
        {
          "command": "claudeEdits.keepFile",
          "when": "resourcePath in claudeEdits.changedFiles",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeEdits.keepFile",
          "when": "resourcePath in claudeEdits.changedFiles"
        },
        {
          "command": "claudeEdits.undoFile",
          "when": "resourcePath in claudeEdits.changedFiles"
        },
        {
          "command": "claudeEdits.openFile",
          "when": "false"
        },
        {
          "command": "claudeEdits.openDiff",
          "when": "false"
        },
        {
          "command": "claudeEdits.keepSession",
          "when": "false"
        },
        {
          "command": "claudeEdits.dismiss",
          "when": "false"
        }
      ]
    }
  }
}
