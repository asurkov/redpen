{
  "name": "redpen",
  "displayName": "redpen",
  "description": "Lists the files Claude Code sessions edited, as redpen's recorder keeps them, with their changes side by side, and opens their review on redpen's page.",
  "publisher": "local",
  "version": "0.6.1",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "redpen",
          "title": "redpen",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "redpen": [
        {
          "id": "redpen.files",
          "name": "Files"
        }
      ]
    },
    "commands": [
      {
        "command": "redpen.refresh",
        "title": "Refresh",
        "category": "redpen",
        "icon": "$(refresh)"
      },
      {
        "command": "redpen.openFile",
        "title": "Open File",
        "category": "redpen",
        "icon": "$(go-to-file)"
      },
      {
        "command": "redpen.openDiff",
        "title": "Open Changes",
        "category": "redpen",
        "icon": "$(diff)"
      },
      {
        "command": "redpen.openReview",
        "title": "Open Review",
        "category": "redpen",
        "icon": "$(preview)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "redpen.openReview",
          "when": "view == redpen.files",
          "group": "navigation@1"
        },
        {
          "command": "redpen.refresh",
          "when": "view == redpen.files",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "redpen.openFile",
          "when": "view == redpen.files && viewItem == file",
          "group": "inline@1"
        },
        {
          "command": "redpen.openReview",
          "when": "view == redpen.files && viewItem == session",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "redpen.openFile",
          "when": "false"
        },
        {
          "command": "redpen.openDiff",
          "when": "false"
        }
      ]
    }
  }
}
