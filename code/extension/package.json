{
  "name": "redpen",
  "displayName": "redpen",
  "description": "A status-bar item that counts the files Claude Code sessions changed, as redpen's recorder keeps them, and opens their review on redpen's page.",
  "publisher": "local",
  "version": "0.7.0",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "redpen.openReview",
        "title": "Open Review",
        "category": "redpen"
      }
    ]
  }
}
